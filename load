-- Mouse input for rapid fire
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isShooting = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isShooting = false
	end
end)

-- Main loop
RunService.Heartbeat:Connect(function()
	-- Hitbox expansion
	if settings.hitboxEnabled then
		for _, plr in pairs(workspace:GetChildren()) do
			if plr:IsA("Model") then
				local head = plr:FindFirstChild("Head")
				if head and plr.Name ~= player.Name then
					if not plr:FindFirstChildOfClass("Highlight") then
						local ESP = Instance.new("Highlight")
						ESP.FillColor = Color3.fromRGB(255, 0, 0)
						ESP.OutlineColor = Color3.fromRGB(255, 100, 100)
						ESP.Parent = plr
					end
					
					if head:IsA("Part") then
						head.Size = Vector3.new(5, 5, 5)
						head.Transparency = 0.5
						head.CanCollide = false
						
						local mesh = head:FindFirstChildOfClass("SpecialMesh")
						if mesh then
							mesh:Destroy()
						end
					end
				end
			end
		end
		
		if workspace:FindFirstChild("BotNPCs") then
			if workspace.BotNPCs:FindFirstChild("Central") then
				for _, bot in pairs(workspace.BotNPCs.Central:GetChildren()) do
					if bot:IsA("Model") then
						local head = bot:FindFirstChild("Head")
						if head then
							if not bot:FindFirstChildOfClass("Highlight") then
								local ESP = Instance.new("Highlight")
								ESP.FillColor = Color3.fromRGB(0, 255, 0)
								ESP.OutlineColor = Color3.fromRGB(100, 255, 100)
								ESP.Parent = bot
							end
							
							if head:IsA("Part") then
								head.Size = Vector3.new(5, 5, 5)
								head.Transparency = 0.5
								head.CanCollide = false
								
								local mesh = head:FindFirstChildOfClass("SpecialMesh")
								if mesh then
									mesh:Destroy()
								end
							end
						end
					end
				end
			end
			
			if workspace.BotNPCs:FindFirstChild("Entente") then
				for _, bot in pairs(workspace.BotNPCs.Entente:GetChildren()) do
					if bot:IsA("Model") then
						local head = bot:FindFirstChild("Head")
						if head then
							if not bot:FindFirstChildOfClass("Highlight") then
								local ESP = Instance.new("Highlight")
								ESP.FillColor = Color3.fromRGB(0, 255, 0)
								ESP.OutlineColor = Color3.fromRGB(100, 255, 100)
								ESP.Parent = bot
							end
							
							if head:IsA("Part") then
								head.Size = Vector3.new(5, 5, 5)
								head.Transparency = 0.5
								head.CanCollide = false
								
								local mesh = head:FindFirstChildOfClass("SpecialMesh")
								if mesh then
									mesh:Destroy()
								end
							end
						end
					end
				end
			end
		end
	end
	
	-- No Spread - aggressively set Spread to 0
	-- Check equipped tool
	local tool = getEquippedTool()
	if tool and tool:FindFirstChild("Statistics") then
		local stats = tool.Statistics
		
		-- Set Spread to 0 if no spread is enabled
		if settings.noSpreadEnabled and stats:FindFirstChild("Spread") then
			stats.Spread.Value = 0
		end
		
		-- Set ROF to minimum if rapid fire is enabled
		if settings.rapidFireEnabled and stats:FindFirstChild("ROF") then
			stats.ROF.Value = 0.01
		end
	end
	
	-- Also check backpack tools
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, tool in pairs(backpack:GetChildren()) do
			if tool:IsA("Tool") and tool:FindFirstChild("Statistics") then
				local stats = tool.Statistics
				if settings.noSpreadEnabled and stats:FindFirstChild("Spread") then
					stats.Spread.Value = 0
				end
				if settings.rapidFireEnabled and stats:FindFirstChild("ROF") then
					stats.ROF.Value = 0.01
				end
			end
		end
	end
	
	-- Rapid fire
	if settings.rapidFireEnabled and isShooting then
		rapidShoot()
	end
end)

