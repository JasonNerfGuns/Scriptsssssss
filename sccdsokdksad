    -- Function to update status message with fade
    local function updateStatus(text, color)
        statusMessage.Text = text
        statusMessage.TextColor3 = color or Color3.fromRGB(0, 255, 100)
        statusMessage.TextTransparency = 0
        
        -- Fade out the status message after 2 seconds
        delay(2, function()
            for i = 0, 1, 0.1 do
                if statusMessage and statusMessage.Parent then
                    statusMessage.TextTransparency = i
                    wait(0.05)
                end
            end
            if statusMessage and statusMessage.Parent then
                statusMessage.Text = ""
                statusMessage.TextTransparency = 0
            end
        end)
    end
    
    -- Function to teleport to SafePlate
    local function teleportToSafePlate()
        local safePlate = workspace:FindFirstChild("SafePlate")
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        
        if safePlate and humanoidRootPart then
            -- Create a tween for smooth teleportation
            local destination = safePlate.CFrame + Vector3.new(0, 5, 0) -- Teleport slightly above to avoid getting stuck
            local teleportTween = TweenService:Create(
                humanoidRootPart,
                TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {CFrame = destination}
            )
            teleportTween:Play()
            
            updateStatus("Teleported to SafePlate")
        else
            updateStatus("Error: SafePlate or character not found!", Color3.fromRGB(255, 50, 50))
        end
    end
    
    -- NEW: Function to teleport to a random spawn
    local function teleportToRandomSpawn()
        local spawnsFolder = workspace:FindFirstChild("Spawns")
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        
        if not humanoidRootPart then
            updateStatus("Error: Character not found!", Color3.fromRGB(255, 50, 50))
            return
        end
        
        if not spawnsFolder then
            updateStatus("Error: Spawns folder not found!", Color3.fromRGB(255, 50, 50))
            return
        end
        
        -- Collect all spawn points
        local spawnPoints = {}
        for _, spawn in pairs(spawnsFolder:GetChildren()) do
            if spawn:IsA("BasePart") then
                table.insert(spawnPoints, spawn)
            end
        end
        
        if #spawnPoints == 0 then
            updateStatus("Error: No spawn points found!", Color3.fromRGB(255, 50, 50))
            return
        end
        
        -- Select random spawn point
        local randomSpawn = spawnPoints[math.random(1, #spawnPoints)]
        
        -- Create a tween for smooth teleportation
        local destination = randomSpawn.CFrame + Vector3.new(0, 3, 0) -- Teleport slightly above
        local teleportTween = TweenService:Create(
            humanoidRootPart,
            TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {CFrame = destination}
        )
        teleportTween:Play()
        
        updateStatus("Teleported to random spawn: " .. randomSpawn.Name)
    end
    
    -- Function to bring an object to player using CFrame (client-sided)
    local function bringObjectWithCFrame(objectName, parentPath)
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        
        if not humanoidRootPart then
            updateStatus("Error: Character not found!", Color3.fromRGB(255, 50, 50))
            return
        end
        
        -- Try to find the object using the specified path
        local object = nil
        
        if parentPath then
            local parent = workspace
            for _, pathPart in ipairs(parentPath) do
                if parent then
                    parent = parent:FindFirstChild(pathPart)
                end
            end
            
            if parent then
                object = parent:FindFirstChild(objectName)
            end
        else
            -- Try to find the object in workspace or in the Swords folder
            object = workspace:FindFirstChild(objectName)
            if not object and workspace:FindFirstChild("Swords") then
                object = workspace.Swords:FindFirstChild(objectName)
            end
        end
        
        if not object then
            updateStatus("Error: " .. objectName .. " not found!", Color3.fromRGB(255, 50, 50))
            return
        end
        
        -- Store the original CFrame
        local originalCFrames = {}
        
        -- Store all descendants that are BaseParts
        for _, part in pairs(object:GetDescendants()) do
            if part:IsA("BasePart") then
                originalCFrames[part] = part.CFrame
            end
        end
        
        -- If it's a model, also store the primary part if it exists
        if object:IsA("Model") and object.PrimaryPart then
            originalCFrames["primaryPart"] = object.PrimaryPart.CFrame
        end
        
        -- Position in front of the player
        local playerPosition = humanoidRootPart.Position + humanoidRootPart.CFrame.lookVector * 5
        local playerCFrame = CFrame.new(playerPosition, humanoidRootPart.Position)
        
        -- Move the object to the player
        if object:IsA("Model") and object.PrimaryPart then
            -- Calculate the offset from the current position to keep the orientation
            local offset = object.PrimaryPart.CFrame:ToObjectSpace(CFrame.new(object.PrimaryPart.Position))
            object:SetPrimaryPartCFrame(playerCFrame * offset)
        elseif object:IsA("BasePart") then
            -- For a single part
            object.CFrame = playerCFrame
        else
            -- For models without a primary part, move individual parts
            local foundAnyPart = false
            for _, part in pairs(object:GetDescendants()) do
                if part:IsA("BasePart") then
                    if not foundAnyPart then
                        -- Use the first part as reference for positioning
                        local centerPos = part.Position
                        local offset = part.CFrame:ToObjectSpace(CFrame.new(centerPos))
                        part.CFrame = playerCFrame * offset
                        foundAnyPart = true
                    else
                        -- Keep relative positions for other parts
                        part.CFrame = playerCFrame * part.CFrame:ToObjectSpace(CFrame.new(part.Position))
                    end
                end
            end
            
            if not foundAnyPart then
                updateStatus("Error: No parts found in " .. objectName, Color3.fromRGB(255, 50, 50))
                return
            end
        end
        
        updateStatus(objectName .. " brought to you (Client-Sided)")
        
        -- Restore original position after 10 seconds
        delay(10, function()
            -- Restore all parts to original positions
            for part, originalCFrame in pairs(originalCFrames) do
                if part == "primaryPart" and object:IsA("Model") and object.PrimaryPart then
                    object:SetPrimaryPartCFrame(originalCFrame)
                elseif typeof(part) == "Instance" and part:IsA("BasePart") and part.Parent then
                    part.CFrame = originalCFrame
                end
            end
            
            updateStatus(objectName .. " returned to original position")
        end)
    end
    
