-- Function to update player list with proper UI for each player
local function updatePlayerList()
    for _, child in pairs(playerScrollFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    -- Get all players and create buttons for them
    local buttonHeight = 30
    local playerList = Players:GetPlayers()
    
    -- Update canvas size based on number of players
    playerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, #playerList * (buttonHeight + listLayout.Padding.Offset) + padding.PaddingTop.Offset + padding.PaddingBottom.Offset)
    
    for _, p in pairs(playerList) do
        local playerButton = Instance.new("TextButton")
        playerButton.Name = p.Name .. "Button"
        playerButton.Size = UDim2.new(1, -10, 0, buttonHeight)
        playerButton.Text = p.Name
        playerButton.TextColor3 = colorScheme.text
        playerButton.BackgroundColor3 = colorScheme.playerButton
        playerButton.Font = Enum.Font.GothamSemibold
        playerButton.TextSize = 14
        playerButton.AutoButtonColor = false
        playerButton.Parent = playerScrollFrame
        roundify(playerButton)
        
        playerButton.MouseButton1Click:Connect(function()
            selectedPlayerName = p.Name
            
            -- Update all buttons to show selection
            for _, button in pairs(playerScrollFrame:GetChildren()) do
                if button:IsA("TextButton") then
                    button.BackgroundColor3 = button.Name == selectedPlayerName .. "Button" 
                        and colorScheme.playerButtonSelected 
                        or colorScheme.playerButton
                end
            end
        end)
    end
end

