-- Function to update WS display continuously
local function updateWsDisplay()
    while wait(0.5) do
        pcall(function()
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                local currentSpeed = player.Character.Humanoid.WalkSpeed
                currentWsLabel.Text = tostring(math.floor(currentSpeed))
                
                -- If the walkspeed seems to have been reset by the game, try to reapply it
                local desiredSpeed = tonumber(wsInput.Text)
                if desiredSpeed and math.abs(currentSpeed - desiredSpeed) > 0.5 then
                    player.Character.Humanoid.WalkSpeed = desiredSpeed
                end
            end
        end)
    end
end

