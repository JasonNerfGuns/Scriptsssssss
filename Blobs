-- Function to teleport all "Food" parts from Blobs to player continuously
local function loopTeleportFoodParts()
    while true do
        if isTeleportingFood then
            pcall(function() -- Use pcall to prevent script errors from stopping the loop
                if blobsFolder and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local playerPosition = player.Character.HumanoidRootPart.CFrame
                    
                    for _, blobModel in ipairs(blobsFolder:GetChildren()) do
                        for _, foodPart in ipairs(blobModel:GetChildren()) do
                            if foodPart:IsA("BasePart") and foodPart.Name == "Food" then
                                foodPart.CFrame = playerPosition + Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))

                                -- Activate TouchInterest inside the part
                                local touchInterest = foodPart:FindFirstChildOfClass("TouchTransmitter")
                                if not touchInterest then
                                    touchInterest = Instance.new("TouchTransmitter")
                                    touchInterest.Parent = foodPart
                                end
                            end
                        end
                    end
                end
            end)
        end
        wait(0.5) -- Teleport every half second for better response
    end
end

-- Function to teleport a selected player to you
local function teleportPlayer(targetPlayer)
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and 
       player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local targetPosition = player.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0) -- Slightly above player
        targetPlayer.Character.HumanoidRootPart.CFrame = targetPosition
        return true
    else
        return false
    end
end

-- Function to teleport all players to you
local function teleportAllPlayers()
    local successCount = 0
    local failCount = 0
    
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        for _, targetPlayer in pairs(Players:GetPlayers()) do
            if targetPlayer ~= player then -- Don't teleport yourself
                local success = teleportPlayer(targetPlayer)
                if success then
                    successCount = successCount + 1
                else
                    failCount = failCount + 1
                end
            end
        end
        return successCount, failCount
    else
        return 0, #Players:GetPlayers() - 1
    end
end

-- Function to set player's walkspeed
local function setWalkSpeed(speed)
    local success = false
    pcall(function()
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.WalkSpeed = speed
            success = true
        end
    end)
    return success
end

-- Function to create rounded corners for UI elements
local function roundify(guiObject)
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 8)
    UICorner.Parent = guiObject
    return guiObject
end

-- Function to create a drop shadow effect
local function addShadow(guiObject, shadowSize)
    local shadow = Instance.new("ImageLabel")
    shadow.AnchorPoint = Vector2.new(0.5, 0.5)
    shadow.BackgroundTransparency = 1
    shadow.Image = "rbxassetid://1316045217" -- Shadow image
    shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    shadow.ImageTransparency = 0.7
    shadow.Position = UDim2.fromScale(0.5, 0.5)
    shadow.Size = UDim2.new(1, shadowSize, 1, shadowSize)
    shadow.ZIndex = guiObject.ZIndex - 1
    shadow.Parent = guiObject
    return shadow
end

-- Function to create a button with hover effect
local function createStyledButton(parent, position, size, text)
    local button = Instance.new("TextButton")
    button.Size = size
    button.Position = position
    button.Text = text
    button.BackgroundColor3 = colorScheme.button
    button.TextColor3 = colorScheme.buttonText
    button.Font = Enum.Font.GothamSemibold
    button.TextSize = 14
    button.Parent = parent
    
    roundify(button)
    
    -- Create hover effects
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = colorScheme.buttonHover}):Play()
    end)
    
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = colorScheme.button}):Play()
    end)
    
    return button
end

-- Create stylish status message
local function showStatusMessage(parent, message, isSuccess)
    local statusFrame = parent:FindFirstChild("StatusFrame")
    if not statusFrame then
        statusFrame = Instance.new("Frame")
        statusFrame.Name = "StatusFrame"
        statusFrame.Size = UDim2.new(0.9, 0, 0.08, 0)
        statusFrame.Position = UDim2.new(0.05, 0, 0.9, 0)
        statusFrame.BackgroundColor3 = colorScheme.background
        statusFrame.BackgroundTransparency = 0.5
        statusFrame.Parent = parent
        roundify(statusFrame)
        
        local statusText = Instance.new("TextLabel")
        statusText.Name = "StatusText"
        statusText.Size = UDim2.new(1, 0, 1, 0)
        statusText.BackgroundTransparency = 1
        statusText.TextColor3 = colorScheme.text
        statusText.Font = Enum.Font.GothamSemibold
        statusText.TextSize = 14
        statusText.Parent = statusFrame
    end
    
    local statusText = statusFrame.StatusText
    statusText.Text = message
    statusText.TextColor3 = isSuccess and colorScheme.success or colorScheme.error
    
    -- Make it fade in and out
    statusFrame.BackgroundTransparency = 0.5
    statusText.TextTransparency = 0
    
    spawn(function()
        wait(2)
        TweenService:Create(statusFrame, TweenInfo.new(1), {BackgroundTransparency = 1}):Play()
        TweenService:Create(statusText, TweenInfo.new(1), {TextTransparency = 1}):Play()
    end)
end

-- Function to create a styled text input
local function createStyledTextInput(parent, position, size, placeholderText)
    local textBox = Instance.new("TextBox")
    textBox.Size = size
    textBox.Position = position
    textBox.PlaceholderText = placeholderText
    textBox.Text = ""
    textBox.BackgroundColor3 = colorScheme.scrollBackground
    textBox.TextColor3 = colorScheme.text
    textBox.PlaceholderColor3 = Color3.fromRGB(180, 180, 180)
    textBox.Font = Enum.Font.GothamSemibold
    textBox.TextSize = 14
    textBox.ClearTextOnFocus = false
    textBox.Parent = parent
    
    roundify(textBox)
    return textBox
end

